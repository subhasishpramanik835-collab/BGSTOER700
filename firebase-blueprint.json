{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account and profile document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 100 },
        "balance": { "type": "number" },
        "totalWon": { "type": "number" },
        "totalSpent": { "type": "number" },
        "referralCode": { "type": "string", "maxLength": 50 },
        "totalReferrals": { "type": "number" },
        "lastSpinTime": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["id", "name", "phone", "balance"]
    },
    "LotteryDraw": {
      "title": "LotteryDraw",
      "description": "Lottery draw instance",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "ticketPrice": { "type": "number" },
        "firstPrize": { "type": "number" },
        "secondPrize": { "type": "number" },
        "thirdPrize": { "type": "number" },
        "endTime": { "type": "number" },
        "totalTicketsSold": { "type": "number" },
        "drawDurationMs": { "type": "number" }
      },
      "required": ["id", "title", "ticketPrice", "firstPrize"]
    },
    "DepositRequest": {
      "title": "DepositRequest",
      "description": "Deposit transaction request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhone": { "type": "string", "maxLength": 20 },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["upi", "phonepe", "gpay", "paytm", "bank"] },
        "utr": { "type": "string", "maxLength": 100 },
        "screenshotUrl": { "type": "string", "maxLength": 500 },
        "date": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectReason": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "userId", "amount", "method", "utr", "status"]
    },
    "WithdrawalRequest": {
      "title": "WithdrawalRequest",
      "description": "Withdrawal transaction request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhone": { "type": "string", "maxLength": 20 },
        "amount": { "type": "number" },
        "fullName": { "type": "string", "maxLength": 100 },
        "accountNumber": { "type": "string", "maxLength": 50 },
        "ifscCode": { "type": "string", "maxLength": 20 },
        "upiId": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectReason": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "userId", "amount", "status"]
    },
    "PurchasedTicket": {
      "title": "PurchasedTicket",
      "description": "Purchased lottery ticket record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "drawId": { "type": "string", "maxLength": 128 },
        "drawTitle": { "type": "string", "maxLength": 100 },
        "ticketNumber": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "purchaseDate": { "type": "string", "maxLength": 50 },
        "drawTime": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "win", "loss"] },
        "wonAmount": { "type": "number" }
      },
      "required": ["id", "userId", "drawId", "ticketNumber", "price", "status"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Ledger entry for wallet transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "ticket_buy", "win_payout", "wheel_bonus", "admin_bonus"] },
        "amount": { "type": "number" },
        "description": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["completed", "pending", "rejected", "failed"] },
        "date": { "type": "string", "maxLength": 50 },
        "utr": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "userId", "type", "amount", "status"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "In-app notification item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 300 },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "win", "system"] },
        "date": { "type": "string", "maxLength": 50 },
        "read": { "type": "boolean" }
      },
      "required": ["id", "userId", "title", "message", "type", "read"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Interaction analytics event log",
      "type": "object",
      "properties": {
        "event": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "number" },
        "device": { "type": "string", "maxLength": 20 }
      },
      "required": ["event", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/draws/{drawId}": {
      "schema": { "$ref": "#/entities/LotteryDraw" },
      "description": "Active and past lottery draws"
    },
    "/deposits/{depositId}": {
      "schema": { "$ref": "#/entities/DepositRequest" },
      "description": "Deposit transaction requests"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/WithdrawalRequest" },
      "description": "Withdrawal transaction requests"
    },
    "/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/PurchasedTicket" },
      "description": "Purchased lottery tickets"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "Wallet ledger entries"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "User notifications"
    },
    "/analytics/{analyticsId}": {
      "schema": { "$ref": "#/entities/AnalyticsEvent" },
      "description": "User interaction analytics events"
    },
    "/supercar_config/{configId}": {
      "description": "Super Car Draw module settings"
    },
    "/supercar_draws/{drawId}": {
      "description": "Super Car Draw draw results and history"
    },
    "/payment_config/{configId}": {
      "description": "Payment gateway config (UPI ID, QR code image, deposit limits, instructions)"
    },
    "/banner_sliders/{sliderId}": {
      "description": "Homepage banner promotions and carousels"
    },
    "/bonus_rules/{ruleId}": {
      "description": "Bonus balance policy and usage rules"
    },
    "/system_settings/{settingId}": {
      "description": "System settings including SMTP and registration config"
    },
    "/broadcasts/{broadcastId}": {
      "description": "Global promotional broadcast messages"
    }
  }
}
